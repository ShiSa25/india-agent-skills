    {
      "id": "gst.gstin.length",
      "value": 15,
      "unit": "chars",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://www.gst.gov.in/",
      "verified": true,
      "note": "A GSTIN is 15 characters."
    },
    {
      "id": "gst.gstin.checksum",
      "value": {
        "alphabet": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        "radix": 36,
        "oddWeight": 1,
        "evenWeight": 2
      },
      "unit": "algorithm",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://www.gst.gov.in/",
      "verified": true,
      "note": "Odd and even positions are 1-based. For product p add floor(p/36)+p%36. Check character is alphabet[(36 - sum%36) % 36]. Verified in code on 2026-11-01 against the public GSTINs in SPEC §1.1."
    },
    {
      "id": "gst.gstin.entityAlphabet",
      "value": "123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",
      "unit": "alphabet",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://www.gst.gov.in/",
      "verified": true,
      "note": "13th character of a regular, TDS, or TCS GSTIN. 0 is not issued."
    },
    {
      "id": "gst.gstin.marker.regular",
      "value": "Z",
      "unit": "char",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://www.gst.gov.in/",
      "verified": true,
      "note": "14th character of a regular GSTIN."
    },
    {
      "id": "gst.gstin.marker.tds",
      "value": "D",
      "unit": "char",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://www.gst.gov.in/",
      "verified": true,
      "note": "14th character of a TDS deductor GSTIN. Not in the SPEC open UNVERIFIED list."
    },
    {
      "id": "gst.gstin.marker.tcs",
      "value": "C",
      "unit": "char",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://www.cbic.gov.in/",
      "verified": false,
      "note": "14th character C is described as the TCS (e-commerce operator) marker in secondary write-ups only. UNVERIFIED: no primary source was opened. Confirm with the official source before relying on this."
    },
    {
      "id": "gst.gstin.nrtpPrefix",
      "value": "99",
      "unit": "code",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://einvoice1.gst.gov.in/Others/MasterCodes",
      "verified": true,
      "note": "NRTP / OIDAR GSTINs use state code 99."
    },
    {
      "id": "gst.gstin.nrtpSuffix",
      "value": "OS",
      "unit": "chars",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://www.gst.gov.in/",
      "verified": true,
      "note": "13th and 14th characters of an NRTP/OIDAR GSTIN."
    },
    {
      "id": "gst.gstin.uinPattern",
      "value": "^[0-9]{4}[A-Z]{3}[0-9]{5}[0-9A-Z]{3}$",
      "unit": "regex",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://www.cbic.gov.in/",
      "verified": true,
      "note": "UIN shape: state, year, three-letter code (country or UNO), five digits, then two characters that vary (UN, ON, OP, or another pair) and the check character. Do not force the 13th and 14th characters to one pair. Do not apply the PAN rule."
    },
    {
      "id": "gst.gstin.registrationCaveat",
      "value": "Checksum valid ≠ registered/active; check services.gst.gov.in/services/searchtp",
      "unit": "text",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://services.gst.gov.in/services/searchtp",
      "verified": true,
      "note": "Shown whenever the check character matches."
    },
    {
      "id": "gst.gstin.legacyWarning",
      "value": "legacy state code",
      "unit": "text",
      "effectiveFrom": "2017-07-01",
      "effectiveTo": null,
      "source": "https://einvoice1.gst.gov.in/Others/MasterCodes",
      "verified": true,
      "note": "Exact warning for state codes 25 and 28."
    }
  ]
